<hc:Window x:Class="Doctype_Scanning.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:vm="clr-namespace:Doctype_Scanning.ViewModels"
           Title="{Binding Title}" Height="740" Width="820" MinHeight="700" MinWidth="720"
           WindowStartupLocation="CenterScreen"
           Background="{DynamicResource RegionBrush}">

    <hc:Window.DataContext>
        <vm:MainViewModel />
    </hc:Window.DataContext>

    <hc:Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16 12" />
            <Setter Property="Margin" Value="0 0 0 12" />
        </Style>
        <Style x:Key="StepStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0 0 0 8" />
        </Style>
        <Style x:Key="PathStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </hc:Window.Resources>

    <Grid Margin="24 12 24 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0 0 0 16">
            <StackPanel>
                <TextBlock Text="DocType &amp; Typo Checker v1.0" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Scan db3 files for DocType errors and typos in a field picked from the CI."
                           Style="{StaticResource HintStyle}" Margin="0 4 0 0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="Dark mode" Style="{StaticResource HintStyle}" Margin="0 0 8 0" />
                <ToggleButton Style="{StaticResource ToggleButtonSwitch}" IsChecked="{Binding IsDarkMode}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="1. CI (doctypes and fields) and dictionary" Style="{StaticResource StepStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Import CI" Command="{Binding ImportCiCommand}"
                            Style="{StaticResource ButtonPrimary}" Height="34" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Column="1" Text="{Binding CiPath}" ToolTip="{Binding CiPath}"
                               Style="{StaticResource PathStyle}" Margin="14 0" />
                    <TextBlock Grid.Column="2" Text="{Binding CiSummary}" Style="{StaticResource HintStyle}" />
                </Grid>

                <!-- optional: the dictionary becomes the reference of the typo check (instead of the most common value) -->
                <Grid Margin="0 8 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Import Dictionary" Command="{Binding ImportDictionaryCommand}"
                            ToolTip="Dictionary file (e.g. Dictionary_24015.txt). Fields whose CI Keying Dictionary is in it are checked against it."
                            Style="{StaticResource ButtonPrimary}" Height="34" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Column="1" Text="{Binding DictionaryPath}" ToolTip="{Binding DictionaryPath}"
                               Style="{StaticResource PathStyle}" Margin="14 0" />
                    <TextBlock Grid.Column="2" Text="{Binding DictionarySummary}" Style="{StaticResource HintStyle}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="2. DB3 files (or their excel export) to check" Style="{StaticResource StepStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Select DB3 Folder" Command="{Binding SelectDb3FolderCommand}"
                            Style="{StaticResource ButtonPrimary}" Height="34" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="Select Excel Files" Command="{Binding SelectExcelFilesCommand}"
                            ToolTip="Pick one or many excel files (Ctrl / Shift click). Each press adds to the list."
                            Style="{StaticResource ButtonPrimary}" Height="34" HorizontalAlignment="Stretch" Margin="8 0 0 0" />
                    <TextBlock Grid.Column="2" Text="{Binding SourcePath}" ToolTip="{Binding SourceDetails}"
                               Style="{StaticResource PathStyle}" Margin="14 0" />
                    <TextBlock Grid.Column="3" Text="{Binding SourceSummary}" Style="{StaticResource HintStyle}" Margin="0 0 10 0" />
                    <Button Grid.Column="4" Content="Clear" Command="{Binding ClearSourcesCommand}"
                            Style="{StaticResource ButtonDefault}" Height="34" Width="70" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="3. What to check" Style="{StaticResource StepStyle}" />

                <TabControl>
                    <!-- one field, DocType + typo errors -->
                    <TabItem Header="Field check">
                        <StackPanel Margin="0 14 0 0">
                            <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}"
                                      Style="{StaticResource ComboBoxExtend}"
                                      DisplayMemberPath="Display" Height="34" HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding IsIdle}" hc:InfoElement.Placeholder="Import a CI to load its fields" />
                            <TextBlock Text="{Binding ReferenceHint}" Style="{StaticResource HintStyle}" TextWrapping="Wrap" Margin="0 8 0 0" />
                            <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource ButtonSuccess}"
                                    Width="170" Height="38" FontSize="14" HorizontalAlignment="Left" Margin="0 14 0 0" />
                        </StackPanel>
                    </TabItem>

                    <!-- 63564.IDX.001 pre-delivery QC: every selected db3 / excel is one batch with its own report -->
                    <TabItem Header="Pre-delivery QC (63564)">
                        <StackPanel Margin="0 14 0 0">
                            <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                       Text="Flags DocType and header place-name errors (checks 1-12) in each selected db3 / excel. Each file is one batch with its own report; keyed data is never changed." />
                            <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                                <TextBlock Text="Capture share limit (%)" VerticalAlignment="Center" Margin="0 0 12 0"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <hc:NumericUpDown Value="{Binding CaptureLimitPercent}" Minimum="1" Maximum="100"
                                                  DecimalPlaces="0" Width="110" IsEnabled="{Binding IsIdle}" />
                            </StackPanel>
                            <Button Content="Start QC" Command="{Binding StartQcCommand}" Style="{StaticResource ButtonSuccess}"
                                    Width="170" Height="38" FontSize="14" HorizontalAlignment="Left" Margin="0 14 0 0" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0 0 0 12"
                    Visibility="{Binding IsBusy, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ButtonDanger}"
                    Width="100" Height="38" />
        </StackPanel>

        <StackPanel Grid.Row="5" VerticalAlignment="Top">
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="18" Margin="0 0 0 8" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}" />
        </StackPanel>
    </Grid>
</hc:Window>
